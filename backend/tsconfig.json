{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "noImplicitAny": true,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@common/*":["src/common/*"],
      "@auth/*":["src/auth/*"],
      "@core/*":["src/common/*"],
      "@health/*":["src/health/*"],
      "@polls/*":["src/polls/*"],
    }
  },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"]
}
